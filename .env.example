# DataCheck CSV Quality Analyzer — Environment Variables
# Copy this file to .env for local development.
# Never commit .env to version control.
# Set these variables in the PythonAnywhere web interface for production.

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Absolute or relative path to the SQLite database file.
# Must be in a writable directory that is not publicly served.
# Example for PythonAnywhere: /home/<username>/data/requests.db
# Example for local development: ./data/requests.db
DATABASE_PATH=./data/requests.db

# ------------------------------------------------------------------
# File upload limits
# ------------------------------------------------------------------
# Maximum accepted CSV file size in bytes. Default: 5 MB.
MAX_UPLOAD_SIZE=5242880

# Maximum number of rows accepted in an uploaded CSV.
MAX_ROWS=100000

# Maximum number of columns accepted in an uploaded CSV.
MAX_COLUMNS=100

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
# Verbosity level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
